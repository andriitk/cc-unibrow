#!/bin/sh
# Claude Code hook entry point for cc-unibrow.
#
# Forwards the hook to the relay that the Unibrow app links on launch. When the
# app was never installed, this is a no-op and Claude Code behaves as usual.
relay="${HOME}/Library/Application Support/cc-unibrow/bin/unibrow-hook"
if [ ! -x "$relay" ]; then
    # Plugin without the app: say so once per session, then stay out of the way.
    if [ "${1:-}" = "SessionStart" ]; then
        printf '%s\n' '{"systemMessage":"Unibrow: the Claude Code plugin is installed, but the Unibrow app is not. Install it with: curl -fsSL https://raw.githubusercontent.com/andriitk/cc-unibrow/main/install.sh | sh"}'
    fi
    exit 0
fi
# The app handles every event it knows; SessionStart is only for the hint above.
[ "${1:-}" = "SessionStart" ] && exit 0
exec "$relay" "$@"
